# Copy to .env (gitignored) and fill real values. Never commit .env.
# Server also reads real environment variables (they win over .env).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=service-role-key-from-dashboard-settings-API
TG_BOT=telegram-bot-token-from-BotFather
TG_CHAT=telegram-chat-id
ADMIN_TOKEN=change-me
